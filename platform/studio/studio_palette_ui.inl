    else if(command==PaletteCommand::Export){
#ifndef _WIN32
        if(fs::exists(fs::u8path(u.path))){u.error="Choose a new palette filename to avoid overwriting an existing file.";return;}
#endif
        if(write_palette_file(u.path,copy_palette(*t.art,u.index),u.export_act,u.error)){status="Exported palette colors.";u.error.clear();}return;}
    if(added>=0){ok=true;u.index=added;}if(ok){auto current=copy_palette(*t.art,u.index);bool same_scope=(command==PaletteCommand::Undo||command==PaletteCommand::Redo)&&current.name==u.name&&current.words.size()==u.baseline.size();palette_reset(t,u.index,same_scope||command==PaletteCommand::Apply||command==PaletteCommand::Ramp||command==PaletteCommand::Rename||command==PaletteCommand::Assign);if(command==PaletteCommand::Reduce&&u.reduce_options.reserve_tail){int first=(int)u.baseline.size()-u.reduce_options.reserve_tail;u.selected.fill(false);for(int c=first;c<(int)u.baseline.size();++c)u.selected[c]=true;u.slot=first;}status=command==PaletteCommand::Compact&&u.usage_options.copy_only?"Created a clean palette copy. Source colors, pixels and assignments are unchanged; save IMG to keep it.":command==PaletteCommand::Paste?"Pasted "+std::to_string(palette_clipboard_count())+" palette(s) in one Undo step. Sprite assignments are unchanged; save IMG to keep additions.":"Palette updated. Save IMG to keep these changes.";}
