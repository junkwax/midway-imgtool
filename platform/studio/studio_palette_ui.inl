void apply_palette_command(Tab &t){
    auto &u=palettes;auto command=u.command;u.command=PaletteCommand::None;if(command==PaletteCommand::None)return;int added=-1;bool ok=false;finish();
    if(command==PaletteCommand::Apply)ok=t.art->replace_palette_colors(u.index,u.baseline,palette_words(),u.error);
    else if(command==PaletteCommand::Ramp){ok=t.art->replace_palette_colors(u.index,u.baseline,u.ramp_words,u.error);if(ok)u.ramp_mode=false;}
    else if(command==PaletteCommand::Merge){ok=t.art->merge_palette(u.merge_plan,u.allow_approximation,u.error);if(ok){if(u.merge_options.remove_source&&u.merge_options.source<u.index)--u.index;u.merge_mode=false;}}
    else if(command==PaletteCommand::Compact){ok=t.art->compact_palette(u.usage_plan,u.error);if(ok)u.usage_mode=false;}
    else if(command==PaletteCommand::Reset){palette_reset(t,u.index,true);return;}
    else if(command==PaletteCommand::Rename)ok=t.art->rename_palette(u.index,u.name,u.error);
    else if(command==PaletteCommand::New){std::vector<unsigned short> words(u.new_count);for(int i=1;i<u.new_count;++i){int c=(i-1)*31/std::max(1,u.new_count-2);words[i]=(unsigned short)((c<<10)|(c<<5)|c);}added=t.art->add_palette(new_palette_name(*t.art,"PALETTE"),words,u.error);}
    else if(command==PaletteCommand::Duplicate){auto copied=copy_palette(*t.art,u.index);added=t.art->duplicate_palette(u.index,u.error,-1,new_palette_name(*t.art,copied.name));}
    else if(command==PaletteCommand::Paste)added=t.art->add_palette(new_palette_name(*t.art,palette_clipboard.name),palette_clipboard.words,u.error);
    else if(command==PaletteCommand::Delete)ok=t.art->delete_unused_palette(u.index,u.error);
    else if(command==PaletteCommand::Assign)ok=t.art->assign_palette(u.preview_sprite,u.index,u.match,u.error);
    else if(command==PaletteCommand::Private){added=t.art->duplicate_palette(t.art->sprite(u.preview_sprite)->palnum,u.error,u.preview_sprite);}
    else if(command==PaletteCommand::Undo){t.art->undo();ok=true;}
    else if(command==PaletteCommand::Redo){t.art->redo();ok=true;}
    else if(command==PaletteCommand::Import){PaletteTransfer transfer;if(read_palette_file(u.path,transfer,u.error))added=t.art->add_palette(new_palette_name(*t.art,transfer.name),transfer.words,u.error);}
    else if(command==PaletteCommand::Export){
#ifndef _WIN32
        if(fs::exists(fs::u8path(u.path))){u.error="Choose a new palette filename to avoid overwriting an existing file.";return;}
#endif
        if(write_palette_file(u.path,copy_palette(*t.art,u.index),u.export_act,u.error)){status="Exported palette colors.";u.error.clear();}return;}
    if(added>=0){ok=true;u.index=added;}if(ok){auto current=copy_palette(*t.art,u.index);bool same_scope=(command==PaletteCommand::Undo||command==PaletteCommand::Redo)&&current.name==u.name&&current.words.size()==u.baseline.size();palette_reset(t,u.index,same_scope||command==PaletteCommand::Apply||command==PaletteCommand::Ramp||command==PaletteCommand::Rename||command==PaletteCommand::Assign);status="Palette updated. Save IMG to keep these changes.";}
}
