    else if(command==PaletteCommand::Merge){if(u.marked_merge){ok=t.art->merge_marked_palettes(u.marked_plan,u.allow_approximation,u.error)>=0;if(ok){u.index=u.marked_plan.target_after;t.palette_marks.clear();u.merge_mode=u.marked_merge=false;}}else{ok=t.art->merge_palette(u.merge_plan,u.allow_approximation,u.error);if(ok){if(u.merge_options.remove_source&&u.merge_options.source<u.index)--u.index;u.merge_mode=false;}}}
    else if(command==PaletteCommand::Inherit){ok=t.art->inherit_palette_colors(u.inherit_plan,u.inherit_allow,u.error);if(ok)u.inherit_mode=false;}
    else if(command==PaletteCommand::Swatches){ok=t.art->apply_palette_swatches(u.swatch_plan,u.error);if(ok)u.swatch_mode=false;}
    else if(command==PaletteCommand::Reduce){ok=t.art->reduce_palette_colors(u.reduce_plan,u.reduce_allow,u.error);if(ok)u.usage_mode=false;}
    else if(command==PaletteCommand::Compact){if(u.usage_options.copy_only)added=t.art->copy_clean_palette(u.usage_plan,u.error);else ok=t.art->compact_palette(u.usage_plan,u.error);if(ok||added>=0)u.usage_mode=false;}
    else if(command==PaletteCommand::Reset){palette_reset(t,u.index,true);return;}
    else if(command==PaletteCommand::Rename)ok=t.art->rename_palette(u.index,u.name,u.error);
    else if(command==PaletteCommand::New){std::vector<unsigned short> words(u.new_count);for(int i=1;i<u.new_count;++i){int c=(i-1)*31/std::max(1,u.new_count-2);words[i]=(unsigned short)((c<<10)|(c<<5)|c);}added=t.art->add_palette(new_palette_name(*t.art,"PALETTE"),words,u.error);}
