struct PaletteBloodSmoke {
    PaletteReductionSmoke seed;int failures=0;std::vector<unsigned short> result;std::string dense_path;std::vector<unsigned char> dense_original;
    void prepare(App &app,ImGuiIO &io,int frame){auto t=app.tab();auto &art=*t->art;auto &u=app.palettes;auto check=[&](bool ok,const char *label){if(!ok){++failures;fprintf(stderr,"Blood lane UI failure %d (%s): %s / %s\n",frame,label,u.error.c_str(),u.usage_error.c_str());}};
        auto read=[&](const std::string &path){std::ifstream in(fs::u8path(path),std::ios::binary);return std::vector<unsigned char>{std::istreambuf_iterator<char>(in),{}};};
        auto click=[&](int at,ImVec2 p){if(frame==at-1)io.AddMousePosEvent(p.x,p.y);if(frame==at)io.AddMouseButtonEvent(0,true);if(frame==at+1)io.AddMouseButtonEvent(0,false);};
        auto key=[&](int at,ImGuiKey k,bool ctrl=false){if(frame==at||frame==at+1){bool down=frame==at;io.AddKeyEvent(ImGuiMod_Ctrl,down&&ctrl);io.AddKeyEvent(k,down);}};
        if(frame==0){seed.prepare(app,io,0);check(!seed.failures,"source fixture");t->ppp=6;app.mark_sprite(*t,art.sprite_id(3),true);}
        click(4,u.blood_point);if(frame==8)check(u.usage_mode&&u.reduce_mode&&u.usage_valid&&u.reduce_options.reserve_tail==10&&u.reduce_plan.preview.words.size()==64&&u.reduce_plan.preview.depth==6&&!u.reduce_plan.approximate_colors&&!art.dirty(),"default 10-slot exact review");
        click(10,u.blood_count_point);key(14,ImGuiKey_A,true);if(frame==16)io.AddInputCharactersUTF8("12");key(18,ImGuiKey_Enter);if(frame==22)check(u.reduce_options.reserve_tail==12&&u.usage_valid&&!art.dirty(),"adjust blood count");
        click(24,u.blood_fill_point);click(28,u.blood_fill_choices[1]);if(frame==32){check(u.reduce_options.blood_fill==BloodLaneFill::Blank&&u.usage_valid,"choose blank lane");for(int c=52;c<64;++c)check(u.reduce_plan.preview.words[c]==0,"blank reserved slots");}click(34,u.cancel_reduce_point);if(frame==38)check(!u.usage_mode&&!art.dirty()&&read(seed.path)==seed.original&&art.copy(0,0,0,48,64).pixels==seed.pixels,"Cancel leaves exact IMG");
        click(40,u.blood_point);click(45,u.blood_fill_point);click(49,u.blood_fill_choices[2]);if(frame==52){check(u.reduce_options.blood_fill==BloodLaneFill::KeepExisting&&u.usage_valid,"keep blood tail choice");for(int c=54;c<64;++c)check(u.reduce_plan.preview.words[c]==seed.target[c]&&u.reduce_plan.preview.mapping[c]==c,"original tail protected");}click(54,u.cancel_reduce_point);
        click(58,u.blood_point);if(frame==60)result=u.reduce_plan.preview.words;click(62,u.apply_point);
        if(frame==66){check(!u.usage_mode&&copy_palette(art,1).words==result&&art.palette(1)->numc==64&&art.palette(1)->bitspix==6&&std::string(art.undo_label())=="Reserve blood lane","Apply retains palette capacity/depth");int selected=0;for(int c=1;c<64;++c){selected+=u.selected[c];check(u.selected[c]==(c>=54),"blood lane highlighted for editing");}check(selected==10&&u.slot==54&&art.sprite_id(0)==seed.id&&app.mark_count(*t)==1,"selection identity and marks");auto output=(fs::u8path(app.prefs)/"blood-exact.IMG").u8string();check(art.save(output,app.error),"save exact blood lane");auto disk=Artwork::open(output,app.error);check(disk&&disk->disk_version()==0x634&&disk->palette(1)->numc==64&&disk->palette(1)->bitspix==6&&copy_palette(*disk,1).words==result,"same-format reopen");}key(68,ImGuiKey_Z,true);
        if(frame==72)check(art.save(seed.path,app.error)&&read(seed.path)==seed.original,"one Undo restores original bytes");key(74,ImGuiKey_Y,true);if(frame==78)check(copy_palette(art,1).words==result,"Redo lane");key(80,ImGuiKey_Z,true);
        if(frame==84){art.begin("Dense fixture");auto im=art.sprite(0);auto raw=(unsigned char *)im->data_p;int stride=(im->w+3)&~3;for(int y=0;y<im->h;++y)for(int x=0;x<im->w;++x)raw[y*stride+x]=(unsigned char)(1+(x+y*im->w)%63);art.commit();dense_path=(fs::u8path(app.prefs)/"dense.IMG").u8string();check(art.save(dense_path,app.error),"dense fixture save");dense_original=read(dense_path);app.palette_reset(*t,1);}
        click(88,u.blood_point);if(frame==92)check(u.usage_valid&&u.reduce_plan.approximate_colors&&!u.reduce_allow,"dense art needs approximation approval");click(94,u.apply_point);if(frame==98)check(u.usage_mode&&!art.dirty()&&copy_palette(art,1).words==seed.target,"unapproved Apply disabled");click(100,u.reduce_approximate_point);if(frame==104)check(u.reduce_allow,"allow reviewed approximation");click(106,u.blood_fill_point);click(110,u.blood_fill_choices[1]);if(frame==114)check(!u.reduce_allow&&u.reduce_options.blood_fill==BloodLaneFill::Blank,"changed review resets approval");click(116,u.reduce_approximate_point);if(frame==118)result=u.reduce_plan.preview.words;click(120,u.apply_point);
        if(frame==124){check(!u.usage_mode&&copy_palette(art,1).words==result&&art.palette(1)->numc==64&&art.palette(1)->bitspix==6,"apply dense condensing");auto pixels=art.copy(0,0,0,48,64).pixels;for(int c:pixels)check(c>0&&c<54,"character pixels avoid blood lane and transparency");check(copy_palette(art,0).words==seed.source&&app.mark_count(*t)==1,"other palette and marks unchanged");auto output=(fs::u8path(app.prefs)/"blood-dense.IMG").u8string();check(art.save(output,app.error),"save dense blood lane");auto disk=Artwork::open(output,app.error);check(disk&&disk->disk_version()==0x634&&disk->copy(0,0,0,48,64).pixels==pixels&&copy_palette(*disk,1).words==result,"dense roundtrip");}key(126,ImGuiKey_Z,true);
        if(frame==130)check(art.save(dense_path,app.error)&&read(dense_path)==dense_original,"Undo dense restores exact bytes");click(134,u.blood_point);if(frame==138){check(u.usage_valid&&u.reduce_plan.approximate_colors&&!u.reduce_allow,"fresh review remains unapplied");io.AddMousePosEvent(5,5);}
    }
