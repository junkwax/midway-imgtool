        if(frame==38)check(art.save(path,app.error)&&read(path)==original&&art.copy(0,0,0,48,64).pixels==pixels,"one Undo saves original bytes");key(40,ImGuiKey_Y);if(frame==44)check(copy_palette(art,1).words==source,"Redo restores inheritance");key(46,ImGuiKey_Z);
        if(frame==50){auto words=source;for(size_t i=1;i<words.size();++i)words[i]=0x7fff;check(art.replace_palette_colors(0,source,words,app.error),"approximate fixture");app.palette_reset(*t,1);app.sync_palette_marks(*t);t->palette_marks={0};}click(54,u.inherit_point);
        if(frame==58)check(u.inherit_valid&&u.inherit_plan.color_changes&&!u.inherit_allow,"approximation requires approval");click(60,u.apply_point);if(frame==64)check(u.inherit_mode&&copy_palette(art,1).words==target,"unapproved Apply is disabled");click(66,u.inherit_approximate_point);click(70,u.inherit_perceptual_point);if(frame==74)check(u.inherit_options.perceptual&&!u.inherit_allow,"matching change resets approval");click(76,u.inherit_approximate_point);click(80,u.apply_point);
        if(frame==84){check(!u.inherit_mode&&copy_palette(art,1).words==copy_palette(art,0).words,"approved approximation applies");art.undo();art.undo();app.palette_reset(*t,1);app.sync_palette_marks(*t);t->palette_marks={0};}click(88,u.inherit_point);
        if(frame==92){art.color(0,1,0x1234);art.commit();}if(frame==96)check(!u.inherit_valid&&!u.inherit_error.empty(),"changed source invalidates review");click(98,u.apply_point);if(frame==102)check(u.inherit_mode&&copy_palette(art,1).words==target,"stale Apply cannot mutate");click(104,u.cancel_inherit_point);
        if(frame==108){art.undo();app.palette_reset(*t,1);app.sync_palette_marks(*t);t->palette_marks={0};auto im=art.sprite(0);im->opaltbl_p=malloc(16);memset(im->opaltbl_p,0xff,16);((unsigned char *)im->opaltbl_p)[0]=3;}click(112,u.inherit_point);if(frame==116)check(u.inherit_mode&&!u.inherit_valid&&u.inherit_error.find("alternate")!=std::string::npos,"alternate palettes protected");click(118,u.cancel_inherit_point);
        if(frame==122){auto im=art.sprite(0);free(im->opaltbl_p);im->opaltbl_p=nullptr;auto clip=art.copy(0,0,0,2,2);clip.pixels[0]=27;check(art.paste_layer(0,clip,60,0,app.error),"overlay fixture");app.palette_reset(*t,1);app.sync_palette_marks(*t);t->palette_marks={0};}click(126,u.inherit_point);if(frame==130)check(!u.inherit_valid&&u.inherit_error.find("overlays")!=std::string::npos,"overlays protected");click(132,u.cancel_inherit_point);
        if(frame==136){art.undo();app.palette_reset(*t,1);app.sync_palette_marks(*t);t->palette_marks={0};check(app.clipboard.pixels==pixels&&app.palette_clipboard.words==source&&art.save(path,app.error)&&read(path)==original,"clipboards and original save preserved");}click(140,u.inherit_point);if(frame==144){check(u.inherit_mode&&u.inherit_valid&&u.error.empty()&&app.error.empty(),"final reviewed UI");io.AddMousePosEvent(5,5);}
    }
