void start_palette_usage(Tab &t){auto &u=palettes;u.reduce_mode=u.inherit_mode=u.swatch_mode=u.ramp_mode=u.merge_mode=false;u.usage_mode=true;u.usage_generation=t.art->generation();u.usage_valid=false;u.usage_plan={};u.usage_options={};u.usage_options.palette=u.index;u.usage_options.ppp=t.ppp;u.error.clear();u.usage_error.clear();}
void start_palette_clean_copy(Tab &t){start_palette_usage(t);palettes.usage_options.copy_only=true;palettes.usage_options.order=PaletteColorOrder::DarkToLight;}
void refresh_palette_usage(Tab &t){auto &u=palettes;if(t.art->generation()!=u.usage_generation){u.usage_valid=false;u.usage_error="The library changed. Cancel and reopen the usage review.";return;}auto &a=u.usage_options;auto &b=u.usage_plan.options;if(u.usage_plan.owner==t.art.get()&&u.usage_plan.generation==t.art->generation()&&a.palette==b.palette&&a.ppp==b.ppp&&a.pack_live==b.pack_live&&a.recompute_depth==b.recompute_depth&&a.order==b.order&&a.copy_only==b.copy_only)return;u.error.clear();u.usage_valid=plan_palette_compaction(*t.art,a,u.usage_plan,u.usage_error);if(!u.usage_valid){u.usage_plan={};u.usage_plan.owner=t.art.get();u.usage_plan.generation=t.art->generation();u.usage_plan.options=a;}++u.usage_revision;if(u.usage_valid&&!u.usage_plan.preview_sprites.empty()&&std::find(u.usage_plan.preview_sprites.begin(),u.usage_plan.preview_sprites.end(),u.preview_sprite)==u.usage_plan.preview_sprites.end())u.preview_sprite=u.usage_plan.preview_sprites.front();}
