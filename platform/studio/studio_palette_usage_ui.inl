        auto upload=[&](SDL_Texture *tex,bool compacted){auto rgba=render_palette_compaction(*t.art,p,u.preview_sprite,compacted);if(tex&&!rgba.empty()){SDL_SetTextureBlendMode(tex,SDL_BLENDMODE_BLEND);SDL_UpdateTexture(tex,nullptr,rgba.data(),im->w*4);}};upload(u.original,false);upload(u.preview,true);u.tex_usage=true;u.tex_merge=false;u.tex_usage_revision=u.usage_revision;u.tex_sprite=u.preview_sprite;u.tex_doc=t.uid;}
    float width=ImGui::GetContentRegionAvail().x,box=(width-8)*.5f;auto draw=[&](const char *label,SDL_Texture *tex){ImGui::BeginGroup();ImGui::TextDisabled("%s",label);auto a=ImGui::GetCursorScreenPos();ImVec2 size(box,200);ImGui::InvisibleButton(label,size);auto dl=ImGui::GetWindowDrawList();dl->PushClipRect(a,a+size,true);for(float y=0;y<size.y;y+=12)for(float x=0;x<size.x;x+=12)dl->AddRectFilled(a+ImVec2(x,y),a+ImVec2(std::min(x+12,size.x),std::min(y+12,size.y)),(((int)x/12+(int)y/12)&1)?IM_COL32(41,44,51,255):IM_COL32(33,36,43,255));if(tex){float z=std::min((size.x-14)/im->w,(size.y-14)/im->h);ImVec2 sprite(im->w*z,im->h*z),pos=a+(size-sprite)*.5f;dl->AddImage((ImTextureID)(intptr_t)tex,pos,pos+sprite);}dl->PopClipRect();ImGui::EndGroup();};draw("Before",u.original);ImGui::SameLine();draw("After",u.preview);
    palette_usage_swatches(p);
    ImGui::TextWrapped(u.reduce_mode?"The result changes colors only when used colors cannot fit. Review LOAD2 packing after changing color count or declared depth.":p.options.copy_only?"The new palette keeps base and overlay colors, including hidden/off-canvas overlays. It is not assigned automatically.":"Unused colors are removed without approximating used colors. Color-count or depth changes can affect LOAD2 and exports; check packing before building.");
