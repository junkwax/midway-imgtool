    ImGui::SeparatorText("Compaction impact");ImGui::Text("%zu primary / %d alternate sprites",p.primary_sprites.size(),p.alternate_sprites);ImGui::Text("%d unused opaque slots / %d removed",p.unused,p.removed);ImGui::Text("%zu -> %zu colors",p.original.size(),p.words.size());ImGui::Text("%llu pixels change index",(unsigned long long)p.index_changes);ImGui::TextDisabled("Exact colors / transparency preserved");
    if(p.indices_locked)ImGui::TextWrapped("Alternate palettes keep indices fixed. Only an unused tail can be removed.");ImGui::TextDisabled("Declared depth: %d -> %d bpp",t.art->palette(u.index)->bitspix,p.depth);if(p.ppp_changed)ImGui::TextColored(ImVec4(1,.72f,.38f,1),"PPP %d fallback changes after compaction",o.ppp);
    ImGui::SeparatorText("Color usage");ImGui::BeginChild("usage-histogram",ImVec2(0,std::max(100.f,ImGui::GetContentRegionAvail().y)),ImGuiChildFlags_Border);uint64_t max=1;for(int i=0;i<(int)p.original.size();++i)max=std::max(max,p.primary[i]+p.alternate[i]);ImGui::PushStyleColor(ImGuiCol_PlotHistogram,accent_surface(.85f));
    if(ImGui::BeginTable("usage-slots",4,ImGuiTableFlags_RowBg|ImGuiTableFlags_BordersInnerV|ImGuiTableFlags_SizingStretchProp)){ImGui::TableSetupColumn("Index",ImGuiTableColumnFlags_WidthFixed,45);ImGui::TableSetupColumn("Pixel refs");ImGui::TableSetupColumn("Usage");ImGui::TableSetupColumn("After",ImGuiTableColumnFlags_WidthFixed,45);ImGui::TableHeadersRow();for(int i=0;i<(int)p.original.size();++i){auto used=p.primary[i]+p.alternate[i];ImGui::TableNextRow();ImGui::TableNextColumn();ImGui::Text("%d",i);ImGui::TableNextColumn();ImGui::Text("%llu",(unsigned long long)used);if(ImGui::IsItemHovered())ImGui::SetTooltip("%llu primary / %llu alternate pixels",(unsigned long long)p.primary[i],(unsigned long long)p.alternate[i]);ImGui::TableNextColumn();ImGui::ProgressBar((float)((double)used/max),ImVec2(-1,12),used?"":"Unused");ImGui::TableNextColumn();bool retained=!i||used||(!(o.pack_live&&!p.indices_locked)&&i<(int)p.words.size());if(retained)ImGui::Text("%d",p.mapping[i]);else ImGui::TextDisabled("--");}ImGui::EndTable();}ImGui::PopStyleColor();ImGui::EndChild();
}
void palette_usage_preview(Tab &t){
    auto &u=palettes;if(!u.usage_valid)return;auto &p=u.usage_plan;ImGui::TextUnformatted("Compacted palette preview");if(p.preview_sprites.empty()){ImGui::TextWrapped("No sprites reference this palette. All opaque colors are unused.");return;}
    ImGui::SetNextItemWidth(-1);if(ImGui::BeginCombo("##usage-sprite",t.art->sprite(u.preview_sprite)->n_s)){for(int index:p.preview_sprites){ImGui::PushID(index);if(ImGui::Selectable(t.art->sprite(index)->n_s,index==u.preview_sprite))u.preview_sprite=index;ImGui::PopID();}ImGui::EndCombo();}ImGui::TextWrapped("The selected palette renders both previews, including alternate references.");
    auto im=t.art->sprite(u.preview_sprite);if(!u.tex_usage||u.tex_usage_revision!=u.usage_revision||u.tex_sprite!=u.preview_sprite||u.tex_doc!=t.uid){if(u.tex_w!=im->w||u.tex_h!=im->h||!u.preview||!u.original){if(u.preview)SDL_DestroyTexture(u.preview);if(u.original)SDL_DestroyTexture(u.original);u.preview=SDL_CreateTexture(renderer,SDL_PIXELFORMAT_RGBA32,SDL_TEXTUREACCESS_STREAMING,im->w,im->h);u.original=SDL_CreateTexture(renderer,SDL_PIXELFORMAT_RGBA32,SDL_TEXTUREACCESS_STREAMING,im->w,im->h);u.tex_w=im->w;u.tex_h=im->h;}
        auto upload=[&](SDL_Texture *tex,bool compacted){auto rgba=render_palette_compaction(*t.art,p,u.preview_sprite,compacted);if(tex&&!rgba.empty()){SDL_SetTextureBlendMode(tex,SDL_BLENDMODE_BLEND);SDL_UpdateTexture(tex,nullptr,rgba.data(),im->w*4);}};upload(u.original,false);upload(u.preview,true);u.tex_usage=true;u.tex_merge=false;u.tex_usage_revision=u.usage_revision;u.tex_sprite=u.preview_sprite;u.tex_doc=t.uid;}
    float width=ImGui::GetContentRegionAvail().x,box=(width-8)*.5f;auto draw=[&](const char *label,SDL_Texture *tex){ImGui::BeginGroup();ImGui::TextDisabled("%s",label);auto a=ImGui::GetCursorScreenPos();ImVec2 size(box,200);ImGui::InvisibleButton(label,size);auto dl=ImGui::GetWindowDrawList();dl->PushClipRect(a,a+size,true);for(float y=0;y<size.y;y+=12)for(float x=0;x<size.x;x+=12)dl->AddRectFilled(a+ImVec2(x,y),a+ImVec2(std::min(x+12,size.x),std::min(y+12,size.y)),(((int)x/12+(int)y/12)&1)?IM_COL32(41,44,51,255):IM_COL32(33,36,43,255));if(tex){float z=std::min((size.x-14)/im->w,(size.y-14)/im->h);ImVec2 sprite(im->w*z,im->h*z),pos=a+(size-sprite)*.5f;dl->AddImage((ImTextureID)(intptr_t)tex,pos,pos+sprite);}dl->PopClipRect();ImGui::EndGroup();};draw("Before",u.original);ImGui::SameLine();draw("After compact",u.preview);
    ImGui::TextWrapped("Unused colors are removed without approximating used colors. Color-count or depth changes can affect LOAD2 and exports; check packing before building.");
}
