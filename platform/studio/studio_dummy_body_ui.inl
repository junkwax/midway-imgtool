void choose_dummy_source(uint64_t uid){auto &u=dummy_body;u.options.doc=uid;u.families.clear();auto source=find(uid);if(source&&discover_dummy_bodies(*source->art,u.families,u.error)){auto best=u.families.end();for(auto i=u.families.begin();i!=u.families.end();++i)if(i->error.empty()&&(best==u.families.end()||i->score>best->score))best=i;if(best==u.families.end()&&!u.families.empty())best=u.families.begin();u.options.prefix=best==u.families.end()?"":best->prefix;}u.dirty=true;}
void rebuild_dummy_body(Tab &t){auto &u=dummy_body;u.options.replace_lane=u.replace?u.selected_lane:0;u.valid=plan_dummy_body(*t.project,u.options,scene_source(),u.plan,u.error);u.dirty=false;u.tick=0;}
void show_dummy_body(Tab &t){finish();clamp_scene_ui(t);dummy_body={};auto &u=dummy_body;u.doc=t.uid;auto &lane=t.project->state.lanes[t.scene.lane];u.selected_lane=lane.id;u.options.flip_x=!lane.flip_x;choose_dummy_source(t.uid);bool complete=std::any_of(u.families.begin(),u.families.end(),[](const DummyBodyFamily &f){return f.error.empty();});if(!complete)for(auto &candidate:tabs){if(candidate->uid==t.uid)continue;std::vector<DummyBodyFamily> families;std::string error;if(discover_dummy_bodies(*candidate->art,families,error)&&std::any_of(families.begin(),families.end(),[](const DummyBodyFamily &f){return f.error.empty();})){choose_dummy_source(candidate->uid);break;}}t.scene.playing=false;edit_doc=t.uid;edit_dialog=EditDialog::DummyBody;rebuild_dummy_body(t);}
