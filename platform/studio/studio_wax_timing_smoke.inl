struct WaxTimingSmoke {
    int failures=0,drag_x=0,drag_y=0;uint64_t owner=0,generation=0,selected=0;std::string wax,native,img,original_wax,img_bytes,png;
    ImVec2 drag;SceneProject *installed=nullptr;
    void prepare(App &app,ImGuiIO &io,int frame){
        auto check=[&](bool ok,const char *label){if(!ok){++failures;fprintf(stderr,"WAX timing UI failure %d (%s): %s / %s\n",frame,label,app.error.c_str(),app.scene_error.c_str());}};
        auto read=[&](const std::string &path){std::ifstream f(fs::u8path(path),std::ios::binary);return std::string{std::istreambuf_iterator<char>(f),{}};};
        auto click=[&](int at,ImVec2 p){if(frame==at-1)io.AddMousePosEvent(p.x,p.y);if(frame==at)io.AddMouseButtonEvent(0,true);if(frame==at+1)io.AddMouseButtonEvent(0,false);};
        auto key=[&](int at,ImGuiKey k){if(frame==at||frame==at+1){bool down=frame==at;io.AddKeyEvent(ImGuiMod_Ctrl,down);io.AddKeyEvent(k,down);}};
        if(frame==0){auto t=app.tab();if(!t){check(false,"source tab");return;}io.AddFocusEvent(true);owner=t->uid;selected=t->selected_id;app.mark_sprite(*t,t->art->sprite_id(2),true);img=(fs::u8path(app.prefs)/"actor.IMG").u8string();wax=(fs::u8path(app.prefs)/"authored.WAX").u8string();native=(fs::u8path(app.prefs)/"authored.ISTUDIO").u8string();png=(fs::u8path(app.prefs)/"before.png").u8string();check(t->art->save(img,app.error),"save fixture source");img_bytes=read(img);generation=t->art->generation();
            original_wax="format=imgtool_world_project\nversion=1\nworld.origin_y=190\ndoc.count=1\ndoc.0.path="+img+"\nslot.count=2\nslot.0.doc_idx=0\nslot.0.sequence_frames=0,1\nslot.0.frame_delays=4,4\nslot.1.doc_idx=0\nslot.1.sequence_frames=2,3\nslot.1.frame_delays=2,2\nslot.1.hold=2\nslot.1.zoom=2\nslot.1.local_dx=-50,-50\nslot.1.motion_dx=1,1\nslot.1.motion_cap_x=8,8\nslot.1.spawn_slot=0\nslot.1.spawn_entry=1\nslot.1.spawn_tick=10\nslot.1.visible_from=10,14\nslot.1.visible_until=13,18\n";{std::ofstream f(fs::u8path(wax),std::ios::binary);f<<original_wax;}app.open_scene(wax);
        }
        auto t=app.find(owner);if(!t||!t->project){check(false,"active composition");return;}auto effect=[&](){for(int i=0;i<(int)t->project->state.lanes.size();++i)if(t->project->state.lanes[i].name=="WAX row 2")return i;return -1;};int lane=effect();if(lane<0){check(false,"effect lane");return;}
        if(frame==3){check(t->project->imported_wax()&&t->project->dirty()&&!t->project->can_undo()&&t->project->import_notes().size()==1&&app.status.find("import notes")!=std::string::npos,"imports with explanation");auto &l=t->project->state.lanes[lane];check(!l.trigger_lane&&l.frames[0].visible_from==10&&l.frames[1].visible_from==14&&l.frames[0].visible_until==13&&l.magnification==2,"authored windows preserved");t->scene.lane=lane;t->scene.frame=0;t->scene.tick=10;t->scene.smoke=true;}
        click(6,app.scene_import_notes_point);if(frame==10)check(app.scene_import_notes_uid==owner&&!t->project->can_undo(),"actual import notes button");click(12,app.scene_import_notes_done_point);if(frame==15)check(!app.scene_import_notes_uid&&!t->project->can_undo(),"closing notes adds no history");
        if(frame==17){drag=ImFloor(t->scene.probe)+ImVec2(1,1);io.AddMousePosEvent(drag.x,drag.y);}if(frame==18)io.AddMouseButtonEvent(0,true);if(frame==19){auto p=ImFloor(drag+ImVec2(6*t->scene.probe_zoom,-3*t->scene.probe_zoom));drag_x=(int)std::round((p.x-drag.x)/t->scene.probe_zoom);drag_y=(int)std::round((p.y-drag.y)/t->scene.probe_zoom);io.AddMousePosEvent(p.x,p.y);}if(frame==20)io.AddMouseButtonEvent(0,false);
        if(frame==24)check(t->project->state.lanes[lane].x==drag_x&&t->project->state.lanes[lane].y==drag_y&&t->project->can_undo(),"drag imported effect");key(26,ImGuiKey_Z);if(frame==30)check(t->project->state.lanes[lane].x==0&&t->project->import_notes().size()==1,"Undo retains authored timing");key(32,ImGuiKey_Y);
        if(frame==36){check(t->project->state.lanes[lane].x==drag_x,"Redo imported actor placement");check(t->project->export_png(png,10,app.scene_source(),app.error),"export authored effect");check(t->project->save(native,app.scene_source(),app.error)&&t->project->import_notes().empty(),"save complete native timing");}
        if(frame==40)app.open_scene(native);
        if(frame==44){check(!t->project->imported_wax()&&!t->project->dirty()&&t->project->import_notes().empty()&&!t->project->state.lanes[lane].trigger_lane,"native reopen");auto out=(fs::u8path(app.prefs)/"after.png").u8string();check(t->project->export_png(out,10,app.scene_source(),app.error)&&read(out)==read(png),"native PNG matches imported composition");installed=t->project.get();}
        if(frame==48){auto bad=original_wax;bad.replace(bad.find("doc.count=1"),11,"doc.count=2");bad+="doc.1.path=missing-timing-source.IMG\nslot.1.frame_doc_idx=1,1\n";auto path=fs::u8path(app.prefs)/"missing.WAX";{std::ofstream f(path,std::ios::binary);f<<bad;}app.open_scene(path.u8string());}
        if(frame==52)check(app.pending_project&&!app.scene_issues.empty()&&app.pending_project->import_notes().size()==1&&t->project.get()==installed&&app.pending_project->state.assets[0].runtime_doc==0,"missing artwork cannot replace open scene");click(56,app.scene_sources_cancel_point);
        if(frame==60){check(!app.pending_project&&t->project.get()==installed&&app.scene_issues.empty()&&!t->project->dirty(),"Cancel failed source resolution");check(read(wax)==original_wax&&read(img)==img_bytes&&t->art->generation()==generation&&!t->art->dirty()&&t->selected_id==selected&&app.mark_count(*t)==1,"WAX and original IMG remain untouched");app.open_scene(wax);}
        if(frame==64){check(t->project->imported_wax()&&t->project->import_notes().size()==1,"reimport timing notes");t->scene.lane=effect();t->scene.frame=0;t->scene.tick=10;}
        click(68,app.scene_import_notes_point);if(frame==72){check(app.scene_import_notes_uid==owner&&!t->project->can_undo(),"notes visible at checkpoint");io.AddMousePosEvent(5,5);}
        if(frame==74)app.action(Action::Quit);if(frame==77)check(!app.scene_import_notes_uid&&app.scene_guard_uid==owner&&app.quitting,"quit dismisses notes and protects dirty scene");click(80,app.scene_cancel_point);
        if(frame==84)check(!app.quitting&&!app.scene_guard_uid&&t->project->dirty()&&t->project->import_notes().size()==1,"Cancel quit keeps imported scene");click(88,app.scene_import_notes_point);if(frame==92){check(app.scene_import_notes_uid==owner&&!t->project->can_undo(),"notes remain available after cancelled quit");io.AddMousePosEvent(5,5);}
    }
};
