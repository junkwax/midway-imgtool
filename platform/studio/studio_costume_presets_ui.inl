std::vector<CostumeSection> costume_current_sections(){std::vector<CostumeSection> rows;for(auto &s:costume.sections)rows.push_back({s.name,s.destination,s.reference,s.enabled});return rows;}
void reload_costume_presets(){auto &m=costume.presets;for(int k=0;k<2;++k){auto path=(fs::u8path(prefs)/(k?"costume_templates.txt":"palette_layouts.txt")).u8string();m.loaded[k]=read_costume_presets(path,(CostumePresetKind)k,m.files[k],m.load_errors[k]);}m.selected=-1;m.valid=false;m.review={};m.error.clear();m.message.clear();m.replace=false;}
void review_saved_costume(Tab &t){auto &u=costume;auto &m=u.presets;m.valid=false;m.review={};m.error.clear();m.message.clear();auto dst=t.art->palette(u.options.palette),ref=t.art->palette(u.options.reference);if(!dst||!ref){m.error="Choose source and reference palettes first.";return;}auto &file=m.files[m.kind];if(m.selected<0)return;
    if(m.kind){if(m.selected<(int)file.templates.size())m.valid=review_costume_template(file.templates[m.selected],dst->numc,ref->numc,m.review,m.error);}
    else if(m.selected<(int)file.layouts.size())m.valid=review_costume_layout(costume_current_sections(),file.layouts[m.selected],m.side==0,dst->numc,ref->numc,m.review,m.error);
}
void suggest_costume_layout(Tab &t){auto &m=costume.presets;m.selected=-1;if(!m.kind&&m.loaded[0]){auto pal=t.art->palette(m.side?costume.options.reference:costume.options.palette);if(pal)m.selected=FindLayoutForPalette(m.files[0].layouts,pal->n_s,pal->numc);}review_saved_costume(t);}
void open_costume_presets(){auto &m=costume.presets;m=CostumePresetsUi{};m.open=true;reload_costume_presets();}
void save_current_costume_preset(Tab &t){auto &u=costume;auto &m=u.presets;auto dst=t.art->palette(u.options.palette),ref=t.art->palette(u.options.reference);if(!dst||!ref)return;auto rows=costume_current_sections();bool ok=false;
    if(m.kind){CostumeTemplate p;if(capture_costume_template(m.name,dst->numc,ref->numc,rows,p,m.error))ok=save_costume_template(m.files[1],p,m.replace,m.error);}
    else{auto pal=m.side?ref:dst;PaletteLayout p;if(capture_costume_layout(m.name,palette_name(*pal),pal->numc,rows,m.side==0,p,m.error))ok=save_costume_layout(m.files[0],p,m.replace,m.error);}
    if(ok){auto &file=m.files[m.kind];m.selected=-1;int count=m.kind?(int)file.templates.size():(int)file.layouts.size();for(int i=0;i<count;++i)if(SameLayoutName(m.name,m.kind?file.templates[i].name:file.layouts[i].name))m.selected=i;review_saved_costume(t);m.message="Saved preset. IMG data and Undo history are unchanged.";m.replace=false;}
}
