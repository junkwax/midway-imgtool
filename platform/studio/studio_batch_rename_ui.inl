void open_batch_rename(Tab &t){finish();renaming=BatchRenameUi{};renaming.open=true;renaming.doc=t.uid;renaming.generation=t.art->generation();renaming.scope=mark_count(t)?0:1;t.alignment.player.playing=t.embedded.playing=t.scene.playing=false;}
void rebuild_batch_rename(Tab &t){auto &u=renaming;std::vector<uint64_t> ids;for(int i=0;i<t.art->count();++i){auto id=t.art->sprite_id(i);if(u.scope==2||(u.scope==0&&marked(t,id))||(u.scope==1&&t.filter.PassFilter(t.art->sprite(i)->n_s)))ids.push_back(id);}u.options.text=u.text;
    u.valid=plan_batch_rename(*t.art,ids,u.options,u.plan,u.error);for(auto &r:u.plan.rows)r.enabled=!u.excluded.count(r.sprite);u.dirty=false;
}
