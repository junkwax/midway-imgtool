void animation_binding_picker(AnimationCopyUi &u,const AnimationCopyBinding &binding,Artwork &target,bool stale,int row){
    auto &b=binding;std::string label=b.target>=0?"["+std::to_string(b.target)+"] "+b.target_name:"Choose sprite...";
    ImGui::BeginDisabled(stale||u.dirty);ImGui::SetNextItemWidth(-1);
    ImGui::SetNextWindowSizeConstraints(ImVec2(300,0),ImVec2(480,360));
    if(ImGui::BeginCombo("##binding",label.c_str())){
        if(ImGui::IsWindowAppearing()){u.binding_filter[0]=0;ImGui::SetKeyboardFocusHere();}
        ImGui::InputTextWithHint("##filter","Search name or sprite index",u.binding_filter,sizeof u.binding_filter);u.binding_filter_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;
        if(ImGui::Selectable("Automatic name match",!b.manual)){u.options.sprite_bindings.erase(b.source_id);u.dirty=true;}
        u.automatic_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;
        ImGui::Separator();ImGui::BeginChild("sprite-choices",ImVec2(0,220));
        std::string filter=u.binding_filter;for(char &c:filter)if(c>='a'&&c<='z')c-=32;
        std::vector<int> choices;for(int i=0;i<target.count();++i){std::string name=target.sprite(i)->n_s;for(char &c:name)if(c>='a'&&c<='z')c-=32;if(filter.empty()||name.find(filter)!=std::string::npos||std::to_string(i)==filter)choices.push_back(i);}
        if(choices.empty())ImGui::TextDisabled("No matching sprites");
        ImGuiListClipper clip;clip.Begin((int)choices.size());while(clip.Step())for(int n=clip.DisplayStart;n<clip.DisplayEnd;++n){int i=choices[n];auto im=target.sprite(i);std::string text="["+std::to_string(i)+"] "+im->n_s+"  /  "+std::to_string(im->w)+" x "+std::to_string(im->h);ImGui::PushID(i);
            if(ImGui::Selectable(text.c_str(),b.target==i)){u.options.sprite_bindings[b.source_id]=target.sprite_id(i);u.dirty=true;ImGui::CloseCurrentPopup();}
            if(i<8)u.binding_choices[i]=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;
            ImGui::SetItemTooltip("Sprite index %d / anchor %d, %d\nAn explicit choice can share a destination with other source sprites.",i,(short)im->anix,(short)im->aniy);ImGui::PopID();
        }
        ImGui::EndChild();ImGui::EndCombo();
    }
    if(row<6)u.binding_points[row]=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;ImGui::EndDisabled();
}
void animation_paste_item(const char *label){item(label,nullptr,Action::PasteAnimations);if(ImGui::IsItemHovered(ImGuiHoveredFlags_AllowWhenDisabled)){if(animation_clipboard){auto &art=animation_clipboard->artwork();ImGui::SetTooltip("%u sequences + %u scripts, %d sprites from %s. Available until replaced, cleared or Studio closes.",art.data.seqcnt,art.data.scrcnt,art.count(),animation_clipboard->label().c_str());}else ImGui::SetTooltip("Copy IMG animations to the animation clipboard first. Other clipboards are separate.");}}
void open_animation_copy(Tab &source){finish();animation_copy=AnimationCopyUi{};auto &u=animation_copy;u.open=true;u.source=source.uid;u.source_generation=source.art->generation();int selected=source.embedded.enabled?source.embedded.record:0;if(selected>=0&&(unsigned)selected<source.art->data.seqcnt+source.art->data.scrcnt)u.options.requested.insert(selected);for(auto &t:tabs)if(t->uid!=source.uid){u.target=t->uid;u.target_generation=t->art->generation();t->alignment.player.playing=t->embedded.playing=t->scene.playing=false;break;}source.alignment.player.playing=source.embedded.playing=source.scene.playing=false;}
void open_animation_capture(Tab &source){open_animation_copy(source);auto &u=animation_copy;u.capture_clipboard=true;u.target=0;u.capture_target=source.art->split_target();u.target_generation=u.capture_target->generation();u.options.copy_missing=true;}
void open_animation_paste(Tab &target){finish();animation_copy=AnimationCopyUi{};auto &u=animation_copy;u.open=u.paste_clipboard=true;u.held=animation_clipboard;u.target=target.uid;u.target_generation=target.art->generation();u.source_generation=u.held->artwork().generation();u.options.copy_missing=true;for(unsigned i=0;i<u.held->artwork().data.seqcnt+u.held->artwork().data.scrcnt;++i)u.options.requested.insert((int)i);target.alignment.player.playing=target.embedded.playing=target.scene.playing=false;}
void open_animation_split(Tab &source){open_animation_capture(source);auto &u=animation_copy;u.capture_clipboard=false;u.split_library=true;}
bool apply_animation_split(Tab &source){auto &u=animation_copy;auto artwork=source.art->prepare_animation_split(u.plan,u.error);if(!artwork)return false;
    try{
        auto next=std::make_unique<Tab>();next->uid=next_uid;next->untitled="Split animations";next->art=std::move(artwork);next->selected_id=next->art->sprite_id(0);next->color=std::min(1,(int)next->art->palette(next->art->sprite(0)->palnum)->numc-1);
        next->alignment.initialize(*next->art);sync_alignment(*next);next->embedded.enabled=true;refresh_embedded(*next);
        if(!next->embedded.error.empty()){u.error=next->embedded.error;return false;}
        next->embedded.record=0;next->embedded.scripts=next->embedded.records[0].script;embedded_floor(*next);
        std::string completed="Created a new IMG with "+std::to_string(next->art->data.seqcnt)+(next->art->data.seqcnt==1?" sequence, ":" sequences, ")+std::to_string(next->art->data.scrcnt)+(next->art->data.scrcnt==1?" script and ":" scripts and ")+std::to_string(next->art->count())+(next->art->count()==1?" sprite.":" sprites.")+" Save the new library when ready; the source is unchanged.";
        tabs.reserve(tabs.size()+1);tabs.push_back(std::move(next));active=(int)tabs.size()-1;select_uid=next_uid++;paste_mode=false;status=std::move(completed);return true;
    }catch(const std::bad_alloc &){u.error="Not enough memory to open the animation library. The source was not changed.";return false;}
}
