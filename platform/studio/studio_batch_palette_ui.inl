void clear_batch_palette_textures(){auto &u=batch_palette;if(u.before_texture)SDL_DestroyTexture(u.before_texture);if(u.after_texture)SDL_DestroyTexture(u.after_texture);u.before_texture=u.after_texture=nullptr;}
void open_batch_palette(Tab &t){finish();clear_batch_palette_textures();batch_palette=BatchPaletteUi{};auto &u=batch_palette;u.open=true;u.doc=t.uid;u.generation=t.art->generation();u.scope=mark_count(t)?0:1;u.options.target=t.art->sprite(t.selected)->palnum;u.options.ppp=t.ppp;t.alignment.player.playing=t.embedded.playing=t.scene.playing=false;}
void rebuild_batch_palette(Tab &t){auto &u=batch_palette;std::vector<uint64_t> ids;for(int i=0;i<t.art->count();++i){auto id=t.art->sprite_id(i);if(u.scope==2||(u.scope==0&&marked(t,id))||(u.scope==1&&t.filter.PassFilter(t.art->sprite(i)->n_s)))ids.push_back(id);}
    u.valid=plan_batch_palette(*t.art,ids,u.options,u.plan,u.error);for(auto &r:u.plan.rows)r.enabled=!u.excluded.count(r.sprite);u.selected=std::clamp(u.selected,0,std::max(0,(int)u.plan.rows.size()-1));u.dirty=false;u.preview_dirty=true;u.allow_approximation=false;
}
