void export_changed(){exporting.valid=false;exporting.destination_valid=false;exporting.error.clear();}
void open_export(Tab &t,ExportKind kind){finish();exporting=ExportUi{};auto &u=exporting;u.open=true;u.doc=t.uid;u.scope=mark_count(t)?0:3;u.options.kind=kind;u.options.bpp=t.ppp>0?t.ppp:-1;if(t.export_initialized){u.options=t.export_options;u.options.kind=kind;u.scope=t.export_scope;u.excluded=t.export_excluded;}auto path=t.art->path().empty()?fs::u8path("sprite-layout"):fs::u8path(t.art->path());path.replace_extension(export_extension(kind));auto text=path.u8string();if(text.size()<sizeof u.path)snprintf(u.path,sizeof u.path,"%s",text.c_str());u.build=true;t.alignment.player.playing=t.embedded.playing=t.scene.playing=false;paste_mode=false;}
void rebuild_export(Tab &t){
    auto &u=exporting;std::vector<ExportRequest> rows;for(int i=0;i<t.art->count();++i){auto id=t.art->sprite_id(i);if(u.scope==2||(u.scope==0&&marked(t,id))||(u.scope==1&&t.filter.PassFilter(t.art->sprite(i)->n_s))||(u.scope==3&&id==t.selected_id))rows.push_back({id,!u.excluded.count(id)});}
    u.valid=plan_export(*t.art,rows,u.options,u.plan,u.error);u.build=false;u.destination_valid=false;u.lines.clear();u.selected=std::clamp(u.selected,0,std::max(0,(int)u.plan.rows.size()-1));
    if(u.valid&&u.plan.ready){auto path=fs::u8path(u.path);if(path.extension().empty()){path.replace_extension(export_extension(u.options.kind));auto value=path.u8string();if(value.size()<sizeof u.path)snprintf(u.path,sizeof u.path,"%s",value.c_str());}
        u.destination_valid=review_export_destination(*t.art,u.plan,u.path,u.destination,u.error);
        if(u.destination_valid)for(auto &other:tabs)if(!other->art->path().empty()){std::error_code ec;auto target=fs::u8path(u.destination.path).lexically_normal(),source=fs::u8path(other->art->path()).lexically_normal();if(target==source||fs::equivalent(target,source,ec)){u.destination_valid=false;u.error="The output cannot replace any open IMG library.";break;}}
        if(u.options.kind!=ExportKind::Irw){std::string text(u.plan.bytes.begin(),u.plan.bytes.end());std::istringstream input(text);std::string line;while(std::getline(input,line)){if(!line.empty()&&line.back()=='\r')line.pop_back();u.lines.push_back(std::move(line));}}
    }
}
