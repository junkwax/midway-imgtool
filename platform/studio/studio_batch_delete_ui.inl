    if(u.dirty&&!stale&&!ImGui::IsAnyItemActive())rebuild_batch_delete(*t);refresh_batch_delete_scenes();ImGui::SameLine();ImGui::BeginChild("delete-review",ImVec2(0,height),ImGuiChildFlags_Border);
