void clear_batch_delete_preview(){if(deleting.preview)SDL_DestroyTexture(deleting.preview);deleting.preview=nullptr;}
void open_batch_delete(Tab &t){finish();clear_batch_delete_preview();deleting=BatchDeleteUi{};auto &u=deleting;u.open=true;u.doc=t.uid;u.generation=t.art->generation();u.scope=mark_count(t)?0:1;t.alignment.player.playing=t.embedded.playing=t.scene.playing=false;}
void rebuild_batch_delete(Tab &t){auto &u=deleting;std::vector<uint64_t> ids;for(int i=0;i<t.art->count();++i){auto id=t.art->sprite_id(i);if(u.scope==2||(u.scope==0&&marked(t,id))||(u.scope==1&&t.filter.PassFilter(t.art->sprite(i)->n_s)))ids.push_back(id);}u.valid=plan_batch_delete(*t.art,ids,u.plan,u.error,u.include_children);for(auto &r:u.plan.rows)r.enabled=!u.excluded.count(r.sprite);u.selected=std::clamp(u.selected,0,std::max(0,(int)u.plan.rows.size()-1));u.dirty=false;u.preview_dirty=true;}
void refresh_batch_delete_scenes(){auto &u=deleting;u.scene_uses.assign(u.plan.rows.size(),{});for(auto &source:tabs)if(source->project){auto uses=batch_delete_scene_uses(u.plan,u.doc,source->project->state,scene_name(*source));for(size_t i=0;i<uses.size();++i)if(!uses[i].empty()){if(!u.scene_uses[i].empty())u.scene_uses[i]+="\n";u.scene_uses[i]+=uses[i];}}}
bool batch_delete_referenced(int row)const{return !deleting.plan.rows[row].references.empty()||!deleting.scene_uses[row].empty();}
void batch_delete_preview(float height){auto &u=deleting;if(!u.valid||u.plan.rows.empty())return;auto &r=u.plan.rows[u.selected];if(u.preview_dirty){clear_batch_delete_preview();u.preview_dirty=false;std::vector<unsigned char> rgba((size_t)r.w*r.h*4);int stride=(r.w+3)&~3;for(int y=0;y<r.h;++y)for(int x=0;x<r.w;++x){int c=r.pixels[y*stride+x];auto out=rgba.data()+((size_t)y*r.w+x)*4;if(c>=(int)r.colors.size()){out[0]=out[2]=255;out[1]=0;}else{unsigned short word=r.colors[c];unsigned char bytes[]={(unsigned char)word,(unsigned char)(word>>8)};pal_word_to_rgb8(bytes,out,out+1,out+2);}out[3]=c?255:0;}u.preview=SDL_CreateTexture(renderer,SDL_PIXELFORMAT_RGBA32,SDL_TEXTUREACCESS_STATIC,r.w,r.h);if(u.preview){SDL_SetTextureBlendMode(u.preview,SDL_BLENDMODE_BLEND);SDL_SetTextureScaleMode(u.preview,SDL_ScaleModeNearest);if(SDL_UpdateTexture(u.preview,nullptr,rgba.data(),r.w*4)!=0)clear_batch_delete_preview();}}
    ImGui::TextWrapped("%s / %d x %d / %s",r.name.c_str(),r.w,r.h,r.enabled?"selected for deletion":"kept");ImGui::BeginChild("delete-sprite-preview",ImVec2(0,std::max(80.f,height)),ImGuiChildFlags_Border);auto a=ImGui::GetCursorScreenPos(),size=ImGui::GetContentRegionAvail();ImGui::InvisibleButton("##delete-preview",size);auto dl=ImGui::GetWindowDrawList();dl->PushClipRect(a,a+size,true);for(float y=a.y;y<a.y+size.y;y+=14)for(float x=a.x;x<a.x+size.x;x+=14)dl->AddRectFilled(ImVec2(x,y),ImMin(ImVec2(x+14,y+14),a+size),(((int)((x-a.x)/14)+(int)((y-a.y)/14))&1)?IM_COL32(38,41,48,255):IM_COL32(29,32,39,255));if(u.preview){float z=std::max(.01f,std::min(12.f,std::min((size.x-18)/r.w,(size.y-18)/r.h)));auto sprite=ImVec2(r.w*z,r.h*z),pos=a+(size-sprite)*.5f;dl->AddImage((ImTextureID)(intptr_t)u.preview,pos,pos+sprite);}dl->PopClipRect();ImGui::EndChild();
}
