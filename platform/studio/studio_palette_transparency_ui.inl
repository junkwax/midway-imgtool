void rebuild_palette_transparency(Tab &t){auto &v=palettes.transparency;v.options.selection=v.scope==1?v.selection:PixelSelection{};v.options.all_users=v.scope==3;std::vector<uint64_t> ids;
    for(int i=0;i<t.art->count();++i){auto id=t.art->sprite_id(i);if(t.art->sprite(i)->palnum==v.options.palette&&((v.scope<=1&&id==v.origin)||(v.scope==2&&marked(t,id))||v.scope==3))ids.push_back(id);}
