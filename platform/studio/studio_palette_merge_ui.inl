    if(u.merge_plan.owner==t.art.get()&&u.merge_plan.generation==t.art->generation()&&a.source==b.source&&a.target==b.target&&a.ppp==b.ppp&&a.grow==b.grow&&a.perceptual==b.perceptual&&a.remove_source==b.remove_source)return;
