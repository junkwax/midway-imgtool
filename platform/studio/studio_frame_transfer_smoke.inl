struct FrameTransferSmoke {
    ActorSplitSmoke fixture;int failures=0;uint64_t first=0,last=0;
    void prepare(App &app,ImGuiIO &io,int frame){
        auto check=[&](bool ok,const char *label){if(!ok){++failures;fprintf(stderr,"Frame transfer UI failure %d (%s): %s / %s\n",frame,label,app.error.c_str(),app.frame_transfer.error.c_str());}};
        auto read=[&](const std::string &path){std::ifstream f(fs::u8path(path),std::ios::binary);return std::string{std::istreambuf_iterator<char>(f),{}};};
        auto click=[&](int at,ImVec2 p,int button=0){if(frame==at-1)io.AddMousePosEvent(p.x,p.y);if(frame==at)io.AddMouseButtonEvent(button,true);if(frame==at+1)io.AddMouseButtonEvent(button,false);};
        auto key=[&](int at,ImGuiKey k){if(frame==at||frame==at+1){bool down=frame==at;io.AddKeyEvent(ImGuiMod_Ctrl,down);io.AddKeyEvent(k,down);}};
        if(frame==0){fixture.prepare(app,io,0);check(!fixture.failures,"source fixture");auto t=app.find(fixture.owner);if(!t||!t->project)return;auto s=t->project->state;SceneLane dest;dest.id=30;dest.name="Destination actor";dest.x=20;dest.delay=3;dest.loop=false;for(int i=0;i<2;++i){SceneFrame f;f.id=31+i;f.name="Destination "+std::to_string(i+1);f.pieces={scene_sprite_reference(*t->art,0,i+6)};dest.frames.push_back(f);}s.lanes.push_back(dest);t->project=std::make_unique<SceneProject>(std::move(s));check(t->project->save(fixture.native,app.scene_source(),app.error),"save transfer fixture");t->scene.lane=0;t->scene.frame=1;t->scene.tick=4;}
        auto t=app.find(fixture.owner);if(!t||!t->project){check(false,"open composition");return;}auto &s=t->project->state;auto &u=t->scene;auto &v=app.frame_transfer;
        click(6,u.actor_actions_point);click(10,u.frame_transfer_point);
        if(frame==14)check(v.open&&!v.move&&v.source==10&&v.selected.count(12)&&!t->project->dirty(),"Actions opens copy review");
        click(16,v.clear_point);click(20,v.pick_points[0]);click(24,v.pick_points[2]);click(28,v.destination_point);click(32,v.destination_choices[2]);click(36,v.insertion_point);click(40,v.insertion_choices[1]);click(44,v.apply_point);
        if(frame==48){check(!v.open&&s.lanes[0].frames.size()==3&&s.lanes[2].frames.size()==4&&u.lane==2&&u.frame==1&&t->project->dirty(),"copy noncontiguous frames into insertion point");if(s.lanes[2].frames.size()==4){first=s.lanes[2].frames[1].id;last=s.lanes[2].frames[2].id;check(first==33&&last==34&&s.lanes[2].frames[1].name=="Pose 1"&&s.lanes[2].frames[2].name=="Pose 3"&&s.lanes[2].frames[2].pieces.size()==2&&s.lanes[2].frames[2].visible_from==12&&s.lanes[1].trigger_lane==10&&s.lanes[1].trigger_frame==13,"source order, fresh IDs, metadata and original follower");}}
        key(50,ImGuiKey_Z);if(frame==54)check(s.lanes[2].frames.size()==2&&!t->project->dirty()&&t->project->can_redo(),"one Undo reverses complete copy");key(56,ImGuiKey_Y);
        if(frame==60){check(s.lanes[2].frames.size()==4&&s.lanes[2].frames[1].id==first,"Redo retains copy identities");check(t->project->save(fixture.native,app.scene_source(),app.error),"save copy");check(t->project->export_png(fixture.png,14,app.scene_source(),app.error),"export copy");}if(frame==64)app.open_scene(fixture.native);
        if(frame==68){auto out=(fs::u8path(app.prefs)/"copy-after.png").u8string();check(!t->project->dirty()&&s.lanes[2].frames.size()==4&&s.lanes[2].frames[2].id==last&&t->project->export_png(out,14,app.scene_source(),app.error)&&read(out)==read(fixture.png),"copy native reopen and identical PNG");u.lane=0;u.frame=2;u.tick=12;}
        click(72,u.frame_points[2],1);click(76,u.frame_transfer_context_point);click(80,v.move_point);click(84,v.apply_point);
        if(frame==88)check(v.open&&v.move&&!v.error.empty()&&s.lanes[0].frames.size()==3&&s.lanes[1].frames.size()==1&&!t->project->dirty(),"context move refuses follower cycle atomically");
        click(92,v.destination_point);click(96,v.destination_choices[2]);click(100,v.apply_point);
        if(frame==104)check(!v.open&&s.lanes[0].frames.size()==2&&s.lanes[2].frames.size()==5&&s.lanes[2].frames[4].id==13&&s.lanes[1].trigger_lane==30&&s.lanes[1].trigger_frame==13&&u.lane==2&&u.frame==4,"move preserves identity and retargets effect");
        key(108,ImGuiKey_Z);if(frame==112)check(!t->project->dirty()&&s.lanes[0].frames.size()==3&&s.lanes[1].trigger_lane==10,"Undo restores moved source and follower");key(114,ImGuiKey_Y);
        if(frame==118){check(s.lanes[1].trigger_lane==30&&s.lanes[2].frames.back().id==13,"Redo move");check(t->project->save(fixture.native,app.scene_source(),app.error)&&t->project->export_png(fixture.png,18,app.scene_source(),app.error),"save/export moved composition");}if(frame==122)app.open_scene(fixture.native);
        if(frame==126){auto out=(fs::u8path(app.prefs)/"move-after.png").u8string();check(!t->project->dirty()&&s.lanes[1].trigger_lane==30&&s.lanes[2].frames.back().id==13&&t->project->export_png(out,18,app.scene_source(),app.error)&&read(out)==read(fixture.png),"move native reopen and PNG equality");u.lane=0;u.frame=0;app.show_frame_transfer(*t,0);}
        if(frame==132){t->project->begin("Position");s.lanes[0].x++;t->project->commit();}click(136,v.apply_point);
        if(frame==140)check(v.open&&!v.error.empty()&&s.lanes[0].frames.size()==2&&s.lanes[2].frames.size()==5&&t->project->dirty(),"stale review refused");click(144,v.cancel_point);
        if(frame==148){check(!v.open,"Cancel review");app.request_close_scene(*t);}if(frame==151)check(app.scene_guard_uid==fixture.owner,"dirty scene close guard");click(154,app.scene_cancel_point);
        if(frame==158){auto other=app.find(fixture.other);check(!app.scene_guard_uid&&t->project->dirty()&&other&&t->art->generation()==fixture.generation&&other->art->generation()==fixture.other_generation&&!t->art->dirty()&&!other->art->dirty()&&read(fixture.source)==fixture.source_bytes&&read(other->art->path())==fixture.other_bytes&&app.mark_count(*t)==1,"Cancel close and source IMG bytes/history/marks unchanged");}key(160,ImGuiKey_Z);
        if(frame==164){check(!t->project->dirty(),"Undo stale edit returns saved scene");u.lane=0;u.frame=0;app.show_frame_transfer(*t,0);}click(168,v.move_point);click(172,v.all_point);click(176,v.apply_point);
        if(frame==180){check(v.open&&v.move&&v.selected.size()==2&&s.lanes[0].frames.size()==2&&!t->project->dirty(),"moving all source frames disabled");io.AddMousePosEvent(5,5);}
    }
};
