struct MagnificationSmoke {
    int failures=0,dx=0,dy=0;uint64_t generation=0;std::string img,wax,project;
    int anchor_x=0,anchor_y=0;ImVec2 drag;std::vector<unsigned char> original;std::string img_bytes,wax_bytes;
    void prepare(App &app,ImGuiIO &io,int frame){auto t=app.tab();
        auto check=[&](bool ok,const char *label){if(!ok){++failures;fprintf(stderr,"Magnification UI failure %d (%s): %s / %s\n",frame,label,app.scene_error.c_str(),app.error.c_str());}};
        auto read=[&](const std::string &path){std::ifstream f(fs::u8path(path),std::ios::binary);return std::string{std::istreambuf_iterator<char>(f),{}};};
        auto click=[&](int at,ImVec2 p){if(frame==at-1)io.AddMousePosEvent(p.x,p.y);if(frame==at)io.AddMouseButtonEvent(0,true);if(frame==at+1)io.AddMouseButtonEvent(0,false);};
        auto key=[&](int at,ImGuiKey k){if(frame==at||frame==at+1){bool down=frame==at;io.AddKeyEvent(ImGuiMod_Ctrl,down);io.AddKeyEvent(k,down);}};
        if(frame==0){img=(fs::u8path(app.prefs)/"actor.IMG").u8string();wax=(fs::u8path(app.prefs)/"scaled.WAX").u8string();project=(fs::u8path(app.prefs)/"scaled.ISTUDIO").u8string();check(t->art->save(img,app.error),"save source");generation=t->art->generation();original=t->art->copy(0,0,0,48,64).pixels;anchor_x=t->art->sprite(0)->anix;anchor_y=t->art->sprite(0)->aniy;img_bytes=read(img);wax_bytes="format=imgtool_world_project\nversion=1\nworld.origin_x=200\nworld.origin_y=180\ndoc.count=1\ndoc.0.path="+img+"\nslot.count=1\nslot.0.doc_idx=0\nslot.0.sequence_frames=0,1\nslot.0.frame_delays=4,4\nslot.0.local_dx=4,0\nslot.0.zoom=2\n";{std::ofstream file(fs::u8path(wax),std::ios::binary);file<<wax_bytes;}app.open_scene(wax);t=app.tab();check(t&&t->project&&!app.pending_project,"import WAX");if(t&&t->project)t->scene.smoke=true;io.AddFocusEvent(true);io.AddMousePosEvent(5,5);}
        t=app.tab();if(!t||!t->project){if(frame>0)check(false,"available project");return;}auto &u=t->scene;auto &s=t->project->state;
        if(frame==4)check(t->project->imported_wax()&&s.lanes[0].magnification==2&&t->project->dirty()&&!t->art->dirty(),"imported 2x row");click(8,u.magnification_point);click(12,u.magnification_choices[3]);if(frame==16)check(s.lanes[0].magnification==4&&!u.playing,"4x combo");key(18,ImGuiKey_Z);if(frame==22)check(s.lanes[0].magnification==2,"scale Undo");key(24,ImGuiKey_Y);if(frame==28)check(s.lanes[0].magnification==4,"scale Redo");click(30,u.magnification_point);click(34,u.magnification_choices[2]);if(frame==38)check(s.lanes[0].magnification==3,"3x combo");
        if(frame==40)check(t->project->save(project,app.scene_source(),app.error)&&!t->project->dirty()&&read(project).find("version=5\n")!=std::string::npos,"save scaled Studio project");if(frame==44)check(read(wax)==wax_bytes&&read(img)==img_bytes&&!t->art->dirty(),"source WAX and IMG unchanged");if(frame==46){app.open_scene(project);t=app.tab();if(t&&t->project)t->scene.smoke=true;}
        if(frame==50)check(s.lanes[0].magnification==3&&!t->project->dirty()&&!app.pending_project,"reopen scaled project");
        if(frame==52){drag=ImFloor(u.probe)+ImVec2(1,1);io.AddMousePosEvent(drag.x,drag.y);}if(frame==54)io.AddMouseButtonEvent(0,true);if(frame==55){auto p=ImFloor(drag+ImVec2(8*u.probe_zoom,-4*u.probe_zoom));dx=(int)std::round((p.x-drag.x)/u.probe_zoom);dy=(int)std::round((p.y-drag.y)/u.probe_zoom);io.AddMousePosEvent(p.x,p.y);}if(frame==56)io.AddMouseButtonEvent(0,false);if(frame==60)check(s.lanes[0].x==dx&&s.lanes[0].y==dy&&t->project->dirty()&&!t->art->dirty(),"scaled hit-test and world-space drag");key(64,ImGuiKey_Z);if(frame==68)check(s.lanes[0].x==0&&s.lanes[0].y==0&&s.lanes[0].magnification==3&&!t->project->dirty(),"drag Undo");
        if(frame==72){drag=ImFloor(u.probe)+ImVec2(1,1);io.AddMousePosEvent(drag.x,drag.y);}if(frame==74)io.AddMouseButtonEvent(0,true);if(frame==75)io.AddMousePosEvent(drag.x+6*u.probe_zoom,drag.y+3*u.probe_zoom);if(frame==76)io.AddKeyEvent(ImGuiKey_Escape,true);if(frame==77){io.AddKeyEvent(ImGuiKey_Escape,false);io.AddMouseButtonEvent(0,false);}if(frame==80)check(s.lanes[0].x==0&&s.lanes[0].y==0&&!u.dragging&&!t->project->dirty(),"cancel scaled drag");
        if(frame==82){t->project->begin("Flip scaled frame");s.origin_y=60;s.lanes[0].frames[0].flip_x=s.lanes[0].frames[0].flip_y=true;t->project->commit();}if(frame==86){check(t->project->save(project,app.scene_source(),app.error),"save scaled flips");check(t->project->export_png((fs::u8path(app.prefs)/"scene.png").u8string(),0,app.scene_source(),app.error),"export scaled scene");}if(frame==90){app.open_scene(project);t=app.tab();if(t&&t->project){t->scene.smoke=true;check(t->project->state.lanes[0].magnification==3&&t->project->state.lanes[0].frames[0].flip_y,"reopen scaled mirrors");}}
        click(96,u.magnification_point);click(100,u.magnification_choices[0]);if(frame==104)check(s.lanes[0].magnification==1&&t->project->dirty(),"restore 1x");key(108,ImGuiKey_Z);if(frame==112)check(s.lanes[0].magnification==3&&!t->project->dirty(),"scale Undo after load");key(116,ImGuiKey_Y);if(frame==120)check(s.lanes[0].magnification==1,"scale Redo after load");key(124,ImGuiKey_Z);
        if(frame==130){u.source_doc=t->uid;u.source_sprite=t->art->sprite_id(2);u.command=SceneCommand::AddLane;}if(frame==136){check(s.lanes.size()==2&&s.lanes[0].magnification==3&&s.lanes[1].magnification==1,"new actor scale independent");u.lane=0;u.frame=0;u.tick=0;}if(frame==140)check(t->project->save(project,app.scene_source(),app.error),"save independent actor scales");if(frame==144)check(t->project->export_png((fs::u8path(app.prefs)/"scene.png").u8string(),0,app.scene_source(),app.error),"export final composition");if(frame==148){check(t->art->generation()==generation&&!t->art->dirty()&&t->art->copy(0,0,0,48,64).pixels==original&&t->art->sprite(0)->anix==anchor_x&&t->art->sprite(0)->aniy==anchor_y&&read(img)==img_bytes&&read(wax)==wax_bytes&&!t->project->dirty(),"IMG, anchors and WAX unchanged");io.AddMousePosEvent(5,5);}
    }
};
