        click(48,u.rebuild_point);click(52,u.apply_point);if(frame==56){IndexedMedia decoded;check(!u.open&&read_indexed_media(output,decoded,app.error)&&decoded.words==expected.words&&decoded.pixels==expected.pixels&&!t->art->dirty(),"export resolved indexed LBM");app.open(input);}
        if(frame==60){u.palette=0;u.dirty=true;}click(64,u.rebuild_point);if(frame==68)check(u.valid&&u.batch.palette==0&&u.batch.words==copy_palette(*t->art,0).words,"match existing palette review");click(72,u.apply_point);if(frame==76)check(t->art->count()==count+2&&t->art->palette_count()==palettes+1,"matching adds no palette");key(80,ImGuiKey_Z);if(frame==84)check(t->art->count()==count+1&&!t->art->dirty()&&read(source)==source_bytes,"Undo matching and source bytes unchanged");if(frame==88)app.open(input);if(frame==92){check(u.open&&u.valid&&u.preview&&u.batch.note.find(destination?"DEST remapped":"Halfbrite")!=std::string::npos,"final review");io.AddMousePosEvent(5,5);}
        if(destination){click(96,u.cancel_point);if(frame==100)app.open(blocked);if(frame==104)check(u.open&&!u.valid&&!u.preview&&u.error.find("background")!=std::string::npos&&t->art->count()==count+1&&!t->art->dirty(),"partial plane mask refused without changes");click(108,u.cancel_point);if(frame==112)app.open(input);if(frame==116){check(u.open&&u.valid&&u.preview&&u.batch.note.find("DEST remapped")!=std::string::npos&&read(source)==source_bytes,"final DEST review");io.AddMousePosEvent(5,5);}}
    }
};
