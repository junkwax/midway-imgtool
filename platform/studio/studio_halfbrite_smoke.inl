    void prepare(App &app,ImGuiIO &io,int frame){auto t=app.tab();if(!t){++failures;return;}auto &u=app.legacy_media;
        auto check=[&](bool ok,const char *label){if(!ok){++failures;fprintf(stderr,"Halfbrite UI failure %d (%s): %s / %s\n",frame,label,u.error.c_str(),app.error.c_str());}};
        auto read=[&](const std::string &p){std::ifstream f(fs::u8path(p),std::ios::binary);return std::string{std::istreambuf_iterator<char>(f),{}};};
        auto click=[&](int at,ImVec2 p){if(frame==at-1)io.AddMousePosEvent(p.x,p.y);if(frame==at)io.AddMouseButtonEvent(0,true);if(frame==at+1)io.AddMouseButtonEvent(0,false);};
        auto key=[&](int at,ImGuiKey k){if(frame==at||frame==at+1){bool down=frame==at;io.AddKeyEvent(ImGuiMod_Ctrl,down);io.AddKeyEvent(k,down);}};
        if(frame==0){count=t->art->count();palettes=t->art->palette_count();version=t->art->disk_version();source=(fs::u8path(app.prefs)/"source.IMG").u8string();check(t->art->save(source,app.error),"save source");source_bytes=read(source);input=(fs::u8path(app.prefs)/(destination?"dest.iff":"halfbrite.iff")).u8string();output=(fs::u8path(app.prefs)/"resolved.lbm").u8string();std::vector<unsigned char> b={'F','O','R','M',0,0,0,0,'I','L','B','M'};
            auto chunk=[&](const char *tag,const std::vector<unsigned char> &data){b.insert(b.end(),tag,tag+4);unsigned n=(unsigned)data.size();for(int s=24;s>=0;s-=8)b.push_back((unsigned char)(n>>s));b.insert(b.end(),data.begin(),data.end());if(n&1)b.push_back(0);};
            chunk("BMHD",{0,64,0,32,0,0,0,0,(unsigned char)(destination?3:6),0,1,0,0,0,1,1,0,64,0,32});std::vector<unsigned char> colors;for(int i=0;i<(destination?64:32);++i){colors.push_back((unsigned char)(255-i*8));colors.push_back((unsigned char)(i*8));colors.push_back((unsigned char)(255-i*3));}chunk("CMAP",colors);chunk("CAMG",{0,0,0,(unsigned char)(destination?0:128)});if(destination)chunk("DEST",{6,0,0,37,0,18,0,63});chunk("GRAB",{0,32,0,31});std::vector<unsigned char> pixels;for(int y=0;y<32;++y)for(int p=0;p<(destination?3:6);++p){pixels.push_back(7);for(int byte=0;byte<8;++byte){unsigned bits=0;for(int bit=0;bit<8;++bit){int x=byte*8+bit,index=(x+y)%64;if((index>>p)&1)bits|=128>>bit;}pixels.push_back((unsigned char)bits);}}chunk("BODY",pixels);unsigned n=(unsigned)b.size()-8;for(int i=0;i<4;++i)b[4+i]=(unsigned char)(n>>(24-i*8));{std::ofstream f(fs::u8path(input),std::ios::binary);f.write((const char *)b.data(),b.size());}if(destination){auto partial=b;for(size_t p=12;p+8<partial.size();){unsigned n=(unsigned)partial[p+4]<<24|(unsigned)partial[p+5]<<16|(unsigned)partial[p+6]<<8|partial[p+7];if(!memcmp(partial.data()+p,"DEST",4)){partial[p+15]=31;break;}p+=8+n+(n&1);}blocked=(fs::u8path(app.prefs)/"needs-background.iff").u8string();std::ofstream f(fs::u8path(blocked),std::ios::binary);f.write((const char *)partial.data(),partial.size());}check(read_indexed_media(input,expected,app.error),"decode fixture");if(destination)for(int y=0;y<32;++y)for(int x=0;x<64;++x){int index=(x+y)%8;check(expected.pixels[y*64+x]==(18|(index&1)|((index&2)<<1)|((index&4)<<3)),"explicit DEST mapping");}app.open(input);io.AddFocusEvent(true);io.AddMousePosEvent(5,5);}
