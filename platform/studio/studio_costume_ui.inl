void clear_costume_textures(){auto &u=costume;if(u.before_texture)SDL_DestroyTexture(u.before_texture);if(u.after_texture)SDL_DestroyTexture(u.after_texture);u.before_texture=u.after_texture=nullptr;}
void costume_ranges_from_slots(){auto &u=costume;std::vector<TransferBlock> ranges;for(int c=1;c<(int)u.words.size();){if(!u.options.slots[c]){++c;continue;}int start=c;while(c<(int)u.words.size()&&u.options.slots[c])++c;ranges.push_back({start,c-start});}FormatSlotRanges(ranges.data(),(int)ranges.size(),u.ranges,sizeof u.ranges);}
void detect_costume_ramps(bool reset){auto &u=costume;auto params=MaterialSeedParamsDefault();params.tolerance_deg=u.split;PaletteRampBlock blocks[64];int n=DetectPaletteRampBlocks(u.words.data(),(int)u.words.size(),params,blocks,64);u.blocks.assign(blocks,blocks+n);u.picked.assign(n,0);if(n)u.picked[0]=1;if(reset){u.options.slots.fill(false);if(n)for(int c=blocks[0].start;c<blocks[0].start+blocks[0].count;++c)u.options.slots[c]=true;costume_ranges_from_slots();}u.dirty=true;}
void load_costume_source(Tab &t){auto &u=costume;u.words=copy_palette(*t.art,u.options.palette).words;u.manual=false;u.scope=0;u.preview_sprite=-1;for(int i=0;i<t.art->count();++i)if(t.art->sprite(i)->palnum==u.options.palette){if(u.preview_sprite<0)u.preview_sprite=i;if(t.art->sprite_id(i)==u.origin)u.preview_sprite=i;}detect_costume_ramps(true);if(u.sections.empty())u.sections.push_back(CostumeSectionUi{});u.section=0;snprintf(u.sections[0].destination,sizeof u.sections[0].destination,"%s",u.ranges);if(u.options.reference==u.options.palette||!t.art->palette(u.options.reference))for(int i=0;i<t.art->palette_count();++i)if(i!=u.options.palette){u.options.reference=i;break;}}
void open_costume(Tab &t){finish();clear_costume_textures();costume=CostumeUi{};auto &u=costume;u.open=true;u.doc=t.uid;u.generation=t.art->generation();u.origin=t.selected_id;u.options.palette=t.art->sprite(t.selected)->palnum;load_costume_source(t);t.alignment.player.playing=t.embedded.playing=t.scene.playing=false;}
void rebuild_costume(Tab &t){
    auto &u=costume;u.options.name=u.name;for(int k=0;k<3;++k)u.options.color[k]=(unsigned char)std::lround(std::clamp(u.color[k],0.f,1.f)*255);
    u.options.sections.clear();if(u.options.borrow){for(const auto &section:u.sections)u.options.sections.push_back({section.name,section.destination,section.reference,section.enabled});}
    u.options.slots.fill(false);if(!u.options.borrow&&u.manual){TransferBlock blocks[256];int n=ParseSlotRanges(u.ranges,(int)u.words.size(),blocks,256);if(n<0){u.valid=false;u.error="Use slot ranges such as 1-5, 10-32. Index zero is protected.";u.dirty=false;u.preview_dirty=true;return;}for(int i=0;i<n;++i)for(int c=blocks[i].start;c<blocks[i].start+blocks[i].count;++c)u.options.slots[c]=true;}
    else if(!u.options.borrow){for(size_t b=0;b<u.blocks.size();++b)if(u.picked[b])for(int c=u.blocks[b].start;c<u.blocks[b].start+u.blocks[b].count;++c)u.options.slots[c]=true;costume_ranges_from_slots();}
    std::vector<uint64_t> ids;for(int i=0;i<t.art->count();++i){auto id=t.art->sprite_id(i);if(t.art->sprite(i)->palnum==u.options.palette&&(u.scope==3||(u.scope==1&&id==u.origin)||(u.scope==2&&marked(t,id))))ids.push_back(id);}
    u.valid=plan_costume(*t.art,u.options,ids,u.plan,u.error);if(u.valid&&u.options.borrow)for(auto &row:u.plan.sections)for(int c:row.destination)u.options.slots[c]=true;u.dirty=false;u.preview_dirty=true;
}
