void sync_palette_marks(Tab &t){
    std::vector<const PAL *> order;for(int i=0;i<t.art->palette_count();++i)order.push_back(t.art->palette(i));
    if(t.palette_marks_structure!=t.art->structure_generation()||order!=t.palette_mark_order)t.palette_marks.clear();
    t.palette_marks_structure=t.art->structure_generation();t.palette_mark_order=std::move(order);
}
void refresh_marked_merge(Tab &t){
    auto &u=palettes;if(t.art->generation()!=u.marked_generation){u.merge_valid=false;u.merge_error="The library changed. Cancel and reopen marked merge.";return;}
    if(!u.marked_dirty)return;u.marked_dirty=false;u.allow_approximation=false;u.error.clear();u.marked_options.sources.clear();for(int index:u.marked_candidates)if(!u.marked_excluded.count(index))u.marked_options.sources.push_back(index);
    u.merge_valid=plan_palette_multi_merge(*t.art,u.marked_options,u.marked_plan,u.merge_error);++u.merge_revision;
    if(u.merge_valid&&!u.marked_plan.sprites.empty()&&std::find(u.marked_plan.sprites.begin(),u.marked_plan.sprites.end(),u.preview_sprite)==u.marked_plan.sprites.end())u.preview_sprite=u.marked_plan.sprites.front();
}
void marked_merge_controls(Tab &t){
    auto &u=palettes;refresh_marked_merge(t);bool stale=t.art->generation()!=u.marked_generation;
    ImGui::TextUnformatted("Merge marked palettes");if(!stale)ImGui::TextWrapped("Destination: %s (keeps its existing slots)",t.art->palette(u.index)->n_s);ImGui::TextWrapped("All enabled sources map to one final destination. Exclusions do not clear your marks.");
    ImGui::BeginDisabled(stale);ImGui::BeginChild("marked-palette-sources",ImVec2(0,145),ImGuiChildFlags_Border);
    for(size_t row=0;row<u.marked_candidates.size();++row){int index=u.marked_candidates[row];ImGui::PushID(index);bool enabled=!u.marked_excluded.count(index);std::string name=stale?"Source #"+std::to_string(index+1):palette_name(*t.art->palette(index));if(ImGui::Checkbox(name.c_str(),&enabled)){if(enabled)u.marked_excluded.erase(index);else u.marked_excluded.insert(index);u.marked_dirty=true;}if(row<8)u.marked_row_points[row]=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;
        if(u.merge_valid){auto found=std::find_if(u.marked_plan.sources.begin(),u.marked_plan.sources.end(),[&](const auto &s){return s.palette==index;});if(found!=u.marked_plan.sources.end()){ImGui::TextDisabled("%zu sprites / %d skipped / %s",found->sprites.size(),found->skipped,found->remove?"remove source":"keep source");if(found->alternate_refs)ImGui::TextDisabled("%d alternate references retained",found->alternate_refs);if(found->color_changes)ImGui::TextColored(ImVec4(1,.72f,.38f,1),"%llu pixels approximated",(unsigned long long)found->color_changes);}}
        ImGui::PopID();
    }ImGui::EndChild();u.marked_dirty|=ImGui::Checkbox("Grow for exact colors",&u.marked_options.grow);u.grow_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;u.marked_dirty|=ImGui::Checkbox("Prefer perceptual matches",&u.marked_options.perceptual);u.marked_dirty|=ImGui::Checkbox("Remove sources that become unused",&u.marked_options.remove_unused);u.remove_sources_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;
    ImGui::SetNextItemWidth(-1);u.marked_dirty|=ImGui::SliderInt("##marked-ppp",&u.marked_options.ppp,0,8,"Packing PPP: %d (0 = auto)");ImGui::EndDisabled();refresh_marked_merge(t);
    if(!u.merge_valid){ImGui::TextWrapped("%s",u.merge_error.c_str());return;}auto &p=u.marked_plan;ImGui::SeparatorText("Combined impact");ImGui::Text("%zu source palettes / %zu sprites",p.sources.size(),p.sprites.size());ImGui::Text("%zu -> %zu colors (+%d) / remove %d",p.palettes[u.index].words.size(),p.words.size(),p.added,p.removed);
    if(p.skipped)ImGui::TextWrapped("%d sprites with active alternate palettes stay unchanged.",p.skipped);if(p.ppp_images)ImGui::TextColored(ImVec4(1,.72f,.38f,1),"%d sprites cross the PPP color limit",p.ppp_images);
    if(p.color_changes)ImGui::TextColored(ImVec4(1,.72f,.38f,1),"%llu pixels approximate colors",(unsigned long long)p.color_changes);else ImGui::TextDisabled("Exact colors / transparency preserved");
}
void marked_merge_preview(Tab &t){
    auto &u=palettes;if(!u.merge_valid||u.marked_plan.sprites.empty())return;auto &p=u.marked_plan;
    ImGui::TextUnformatted("Combined merge preview");ImGui::SetNextItemWidth(-1);if(ImGui::BeginCombo("##marked-merge-preview",t.art->sprite(u.preview_sprite)->n_s)){for(int i:p.sprites){ImGui::PushID(i);if(ImGui::Selectable(t.art->sprite(i)->n_s,u.preview_sprite==i))u.preview_sprite=i;ImGui::PopID();}ImGui::EndCombo();}
    auto im=t.art->sprite(u.preview_sprite);if(!u.tex_merge||u.tex_usage||u.tex_merge_revision!=u.merge_revision||u.tex_sprite!=u.preview_sprite||u.tex_doc!=t.uid){
        if(u.tex_w!=im->w||u.tex_h!=im->h||!u.preview||!u.original){if(u.preview)SDL_DestroyTexture(u.preview);if(u.original)SDL_DestroyTexture(u.original);u.preview=SDL_CreateTexture(renderer,SDL_PIXELFORMAT_RGBA32,SDL_TEXTUREACCESS_STREAMING,im->w,im->h);u.original=SDL_CreateTexture(renderer,SDL_PIXELFORMAT_RGBA32,SDL_TEXTUREACCESS_STREAMING,im->w,im->h);u.tex_w=im->w;u.tex_h=im->h;}
        auto upload=[&](SDL_Texture *tex,bool after){auto rgba=render_palette_multi_merge(*t.art,p,u.preview_sprite,after);if(tex&&!rgba.empty()){SDL_SetTextureBlendMode(tex,SDL_BLENDMODE_BLEND);SDL_UpdateTexture(tex,nullptr,rgba.data(),im->w*4);}};upload(u.original,false);upload(u.preview,true);u.tex_merge=true;u.tex_usage=false;u.tex_merge_revision=u.merge_revision;u.tex_sprite=u.preview_sprite;u.tex_doc=t.uid;
    }
    ImGui::TextWrapped("Before / final combined mapping. Alternate-palette sprites are excluded.");float box=(ImGui::GetContentRegionAvail().x-8)*.5f;
    auto draw=[&](const char *label,SDL_Texture *tex){ImGui::BeginGroup();ImGui::TextDisabled("%s",label);auto a=ImGui::GetCursorScreenPos();ImVec2 size(box,200);ImGui::InvisibleButton(label,size);auto dl=ImGui::GetWindowDrawList();dl->PushClipRect(a,a+size,true);for(float y=0;y<size.y;y+=12)for(float x=0;x<size.x;x+=12)dl->AddRectFilled(a+ImVec2(x,y),a+ImVec2(std::min(x+12,size.x),std::min(y+12,size.y)),(((int)x/12+(int)y/12)&1)?IM_COL32(41,44,51,255):IM_COL32(33,36,43,255));if(tex){float z=std::min((size.x-14)/im->w,(size.y-14)/im->h);ImVec2 dimensions(im->w*z,im->h*z),origin=a+(size-dimensions)*.5f;dl->AddImage((ImTextureID)(intptr_t)tex,origin,origin+dimensions);}dl->PopClipRect();ImGui::EndGroup();};draw("Before",u.original);ImGui::SameLine();draw("After",u.preview);
}
void marked_merge_footer(Tab &t){
    auto &u=palettes;auto &p=u.marked_plan;ImGui::TextWrapped("%s",!u.error.empty()?u.error.c_str():!u.merge_error.empty()?u.merge_error.c_str():u.merge_valid&&p.sprites.empty()?"No eligible primary sprites. Unused sources and alternate-palette sprites stay unchanged.":"Review only. Apply combines the enabled sources in one Undo step. Save IMG separately.");
    ImGui::BeginDisabled(!u.merge_valid||!p.color_changes);ImGui::Checkbox("Allow approximate colors",&u.allow_approximation);u.approximate_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;ImGui::EndDisabled();ImGui::SameLine();if(u.merge_valid)ImGui::TextDisabled(p.color_changes?"%llu pixels / reviewed approval required":"Exact colors / one Undo step",(unsigned long long)p.color_changes);
    ImGui::BeginDisabled(!u.merge_valid||u.marked_dirty||p.sprites.empty()||(p.color_changes&&!u.allow_approximation));if(ImGui::Button("Apply marked merge"))u.command=PaletteCommand::Merge;u.apply_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;ImGui::EndDisabled();ImGui::SameLine();if(ImGui::Button("Cancel merge")){u.merge_mode=u.marked_merge=false;u.error.clear();}u.cancel_merge_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;ImGui::SameLine();if(ImGui::Button("Close")){u.open=u.merge_mode=u.marked_merge=false;u.command=PaletteCommand::None;ImGui::CloseCurrentPopup();}u.close_point=(ImGui::GetItemRectMin()+ImGui::GetItemRectMax())*.5f;
}
