    u.valid=plan_restore(*t.art,ids,u.options,u.plan,u.error);for(auto &r:u.plan.rows){if(u.excluded.count(r.child))r.enabled=false;else if(r.status==RestoreStatus::Ready&&u.included.count(r.child))r.enabled=true;}u.selected=std::clamp(u.selected,0,std::max(0,(int)u.plan.rows.size()-1));u.build=false;u.preview_dirty=true;
