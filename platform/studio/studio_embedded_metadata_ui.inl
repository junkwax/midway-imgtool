void show_embedded_metadata(Tab &t){
    finish();t.embedded.playing=false;edit_doc=t.uid;edit_dialog=EditDialog::EmbeddedMetadata;embedded_metadata={};auto &u=embedded_metadata;auto r=embedded_record(t);int entry=r&&!r->entries.empty()?t.embedded.entry:-1;
