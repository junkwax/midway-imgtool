std::string gradient_preset_path(){return (fs::u8path(prefs)/"studio_gradients.txt").u8string();}
void load_studio_gradients(){auto &u=palettes;if(u.presets_loaded)return;u.presets_loaded=true;u.presets_writable=true;u.preset_error.clear();u.presets={{"Grayscale",{{0,0,0},{255,255,255}}},{"Fire",{{12,0,0},{200,24,8},{255,164,36},{255,255,220}}},{"Steel",{{12,16,22},{70,92,110},{220,235,246}}}};std::error_code ec;if(fs::exists(fs::u8path(gradient_preset_path()),ec)){std::vector<GradientPreset> read;if(read_gradient_presets(gradient_preset_path(),read,u.preset_error))u.presets=std::move(read);else u.presets_writable=false;}}
void refresh_palette_ramp(){auto &u=palettes;u.ramp_valid=build_palette_ramp(u.baseline,u.selected,u.ramp_options,u.ramp_words,u.ramp_error);}
void start_palette_ramp(Tab &t){(void)t;auto &u=palettes;u.merge_mode=u.usage_mode=false;u.ramp_mode=true;u.ramp_options={};auto stops=seed_gradient_stops(u.baseline,u.selected,2);if(!stops.empty())u.ramp_options.stops=std::move(stops);u.active_stop=0;u.preset=-1;u.error.clear();load_studio_gradients();refresh_palette_ramp();}
void bake_gradient_shift(){auto &o=palettes.ramp_options;o.stops=shifted_gradient_stops(o.stops,o.hue,o.saturation,o.lightness);o.hue=o.saturation=o.lightness=0;}
void set_ramp_sample(GradientColor color){auto &u=palettes;if(u.ramp_options.shading)u.ramp_options.base=color;else{bake_gradient_shift();u.active_stop=std::clamp(u.active_stop,0,(int)u.ramp_options.stops.size()-1);u.ramp_options.stops[u.active_stop]=color;}refresh_palette_ramp();}
void save_studio_gradient(bool remove){auto &u=palettes;if(!u.presets_writable)return;auto saved=u.presets;int selected=u.preset;if(remove){if(selected<0||selected>=(int)saved.size())return;saved.erase(saved.begin()+selected);selected=-1;}else{GradientPreset entry{u.preset_name,shifted_gradient_stops(u.ramp_options.stops,u.ramp_options.hue,u.ramp_options.saturation,u.ramp_options.lightness)};selected=-1;for(int i=0;i<(int)saved.size();++i)if(saved[i].name==entry.name){selected=i;break;}if(selected>=0)saved[selected]=std::move(entry);else{selected=(int)saved.size();saved.push_back(std::move(entry));}}if(write_gradient_presets(gradient_preset_path(),saved,u.preset_error)){u.presets=std::move(saved);u.preset=selected;status=remove?"Deleted Studio gradient preset.":"Saved Studio gradient preset.";}}
