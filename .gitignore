# Build output / CMake
build/
build-*/
out/
doc/
CMakeCache.txt
CMakeFiles/
prototype_outputs/
codex-build/
cmake_install.cmake
*.vcxproj*
*.sln

# Build artifacts
*.obj
*.exp
*.lib
*.pdb
*.ilk
*.map

# Build scripts output dir
imgtool-build/

# Crash dump
crashdump.dmp

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# AI assistants local config
.claude/

# Ignore all markdown notes by default; whitelist the ones we publish.
*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
# Prose fragments the wiki generator pastes around its generated tables.
# Without this they are swept up by *.md and CI publishes a page with the
# editorial sections missing.
!tools/wiki/*.md

# ImGui window/layout state — per-user, per-display. Committing it is how a
# modal ends up reopening off-screen on someone else machine.
imgui.ini

# BDD/BDB background data. test/bdd_bg_test.cpp writes a set of these into
# the working dir on every run, and a stale set got committed once already.
# Nothing here needs the real assets tracked; force-add if that ever changes.
*.BDD
*.BDB
*.bdd
*.bdb
